# Copy this file to .env.local and put your real key there (never commit .env.local).
# Local:  cp .env.example .env.local   then edit GEMINI_API_KEY
# AI Studio: set GEMINI_API_KEY in the Secrets panel — Studio injects it at runtime.

GEMINI_API_KEY=

# Optional. AI Studio may inject the hosted app URL.
APP_URL=
