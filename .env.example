# Copy to .env.local for local runs only:
#   cp .env.example .env.local
# Then paste your key after the = (no quotes).
#
# AI Studio: do NOT put an empty GEMINI_API_KEY= in the project file.
# Set Secret name exactly: GEMINI_API_KEY  (from https://aistudio.google.com/apikey)
# Empty placeholders can block Secrets from injecting.

# GEMINI_API_KEY=

# Optional STT backup. Free Groq Whisper (~8 h audio/day). If Gemini 429s on
# Stop & transcribe, MyScribe fails over here so the consult is not lost.
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=

# Optional. AI Studio may inject the hosted app URL.
# APP_URL=
